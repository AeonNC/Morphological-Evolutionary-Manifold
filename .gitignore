# Byte-compiled
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
.env
.env.*
!.env.example

# Secrets and credentials
*.pem
*.key
credentials.json
secrets.yaml

# Data (keep gitkeeps)
data/raw/*
!data/raw/_templates/
!data/raw/_templates/**
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
data/manifests/*
!data/manifests/.gitkeep
data/quarantine/*
!data/quarantine/.gitkeep

# Outputs except gitkeeps
outputs/**
!outputs/**/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# Models
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.pickle
*.h5

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test / lint
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Colab
drive/
